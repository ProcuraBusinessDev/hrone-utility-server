[Unit]
Description=ADMS Push Server — biometric terminal attendance receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=<your-user>
WorkingDirectory=/opt/adms-push-server
ExecStart=/usr/bin/python3 -m uvicorn server:app --host 0.0.0.0 --port 8081
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/adms-push-server/server.log
StandardError=append:/var/log/adms-push-server/server.log

# Optional: allow binding port < 1024 without root
# AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
