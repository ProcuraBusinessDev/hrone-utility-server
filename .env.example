# ADMS Push Server — environment configuration
# Copy to .env and adjust for your setup

# Directory where attendance/operlog JSONL files are written
ADMS_DATA_DIR=/var/lib/adms-push-server

# File the server reads injected commands from (append-only queue)
ADMS_CMD_QUEUE=/tmp/adms-cmd-queue.jsonl

# JSONL file for all inbound events
ADMS_EVENT_LOG=/var/log/adms-push-server/events.jsonl
